# Copy to .env and fill in. Never commit .env.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional: public site URL (defaults to the placeholder in src/config/site.ts)
NEXT_PUBLIC_SITE_URL=
# Optional: email copies of enquiries via Resend (server-side only)
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=
