// One-off: converts the original hard-coded catalogue (scripts/seed/catalog.ts) into a SQL seed
// migration. Run with: node scripts/generate-catalogue-seed.mts > supabase/migrations/<ts>_seed_catalogue.sql
import { categories } from "./seed/catalog.ts";
import type { SpecGroup } from "../src/data/types.ts";

const q = (v: string | null | undefined) => (v == null ? "null" : `'${v.replace(/'/g, "''")}'`);
const arr = (v: string[] | undefined) => (v && v.length ? `array[${v.map(q).join(", ")}]::text[]` : "'{}'::text[]");
const json = (v: unknown) => `${q(JSON.stringify(v))}::jsonb`;
const num = (v: number | undefined) => (v == null ? "null" : String(v));

// Split a series' spec groups into a layout (shared values) and per-product values.
function splitSpecs(groups: SpecGroup[], productCount: number) {
  const perProduct: Record<string, string>[] = Array.from({ length: productCount }, () => ({}));
  const layout = groups.map((g) => ({
    title: g.title,
    rows: g.rows.map((row) => {
      if (!Array.isArray(row.value)) return { label: row.label, shared: row.value };
      row.value.forEach((v, i) => {
        if (v !== null && i < productCount) perProduct[i][row.label] = v;
      });
      return { label: row.label };
    }),
  }));
  return { layout, perProduct };
}

const out: string[] = [
  "-- Seed: Africell catalogue (3 categories, 4 series, 18 products) and default site settings.",
  "-- Generated by scripts/generate-catalogue-seed.mts from the original hard-coded catalogue.",
  "",
  "insert into public.brands (slug, name, logo_url, sort_order) values ('africell', 'Africell', '/images/brand/logo.png', 0);",
  "",
];

categories.forEach((cat, ci) => {
  out.push(
    `insert into public.categories (brand_id, slug, name, singular, short_description, description, image, pairs_with, sort_order)
select id, ${q(cat.slug)}, ${q(cat.name)}, ${q(cat.singular)}, ${q(cat.short)}, ${q(cat.description)}, ${q(cat.image)}, ${arr(cat.pairsWith)}, ${ci}
from public.brands where slug = 'africell';`,
  );

  cat.series.forEach((s, si) => {
    const { layout, perProduct } = splitSpecs(s.specs, s.products.length);
    const settings = s.settings ? { title: s.settings.title, rows: s.settings.rows.map((r) => ({ label: r.label, shared: r.value })) } : null;
    out.push(
      `insert into public.product_series (category_id, slug, name, tagline, overview, features, applications, gallery, spec_status, spec_note, spec_layout, settings, guide, in_the_box, downloads, sort_order)
select c.id, ${q(s.slug)}, ${q(s.name)}, ${q(s.tagline)}, ${arr(s.overview)}, ${json(s.features)}, ${arr(s.applications)}, ${arr(s.gallery)}, ${q(s.specStatus)}, ${q(s.specNote)}, ${json(layout)}, ${settings ? json(settings) : "null"}, ${json(s.guide ?? [])}, ${arr(s.inTheBox)}, ${json(s.downloads)}, ${si}
from public.categories c join public.brands b on b.id = c.brand_id
where b.slug = 'africell' and c.slug = ${q(cat.slug)};`,
    );

    s.products.forEach((p, pi) => {
      out.push(
        `insert into public.products (series_id, slug, name, model, chips, power_kva, capacity_kwh, wattage, image, gallery, summary, spec_values, availability, sort_order)
select s.id, ${q(p.slug)}, ${q(p.name)}, ${q(p.model)}, ${arr(p.chips)}, ${num(p.facets.powerKva)}, ${num(p.facets.capacityKwh)}, ${num(p.facets.wattage)}, ${q(p.image)}, ${arr(p.gallery)}, ${q(p.summary)}, ${json(perProduct[pi])}, ${q(p.availability)}, ${pi}
from public.product_series s join public.categories c on c.id = s.category_id
where c.slug = ${q(cat.slug)} and s.slug = ${q(s.slug)};`,
      );
    });
  });
  out.push("");
});

out.push(
  `insert into public.site_settings (id, business_name, address_line, phone_display, phone_e164, whatsapp_number, email, map_url, hours, social)
values (1, 'Africell Energy Solar', 'Showroom address to be confirmed', '+234 000 000 0000', '', '', 'sales@africellsolaraba.com',
  'https://www.google.com/maps/search/?api=1&query=Aba%2C+Abia+State%2C+Nigeria',
  ${json([
    { days: "Monday – Friday", time: "8:00am – 6:00pm" },
    { days: "Saturday", time: "9:00am – 4:00pm" },
    { days: "Sunday", time: "Closed" },
  ])},
  '{}'::jsonb);`,
);

console.log(out.join("\n"));
